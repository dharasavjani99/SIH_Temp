# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://resqtech:resqtech@localhost:5432/resqtech
# For local development without Postgres:
# DATABASE_URL=sqlite:///./resqtech.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Data mode: "demo" uses the seeded CSVs, "live" calls the external adapters.
DATA_MODE=demo

# External sources. Leave blank while running in demo mode.
IMD_API_KEY=
CWC_API_KEY=
BHUVAN_API_KEY=

# LLM for the chatbot. The key is read server-side only and is never
# returned to the browser.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

RISK_MODEL_PATH=app/ml/artifacts/risk_model.joblib
SEG_MODEL_PATH=app/dl/artifacts/impact_seg.pt
